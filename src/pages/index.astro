---
import Welcome from "../components/Welcome.astro";
import GithubContributions from "../components/GithubContributions.astro";
import AsciiVideo from "../components/AsciiVideo.astro";
import DitheredVideo from "../components/DitheredVideo.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import YoutubeIcon from "../components/icons/YoutubeIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import XIcon from "../components/icons/XIcon.astro";
import EmailIcon from "../components/icons/EmailIcon.astro";
import me from "../assets/me.jpg";
import twitter from "../assets/twitter.webp";
import youtube from "../assets/youtube.webp";
import github from "../assets/github.webp";
import screenCcup from "../assets/screen-ccup.webp";
import screenScanTranslator from "../assets/screen-scan-translator.png";
import screenJobx from "../assets/screen-jobx.png";
import screenLavot from "../assets/screen-lavot.webp";
import screenUpcomingGames from "../assets/screen-upcoming-games.webp";
import screenStickMe from "../assets/screen-stick-me.webp";
import laravel from "../assets/tech-laravel.webp";
import js from "../assets/tech-js.webp";
import pgsql from "../assets/tech-pgsql.webp";
