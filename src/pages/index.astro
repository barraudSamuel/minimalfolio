                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent opacity-80 transition duration-300 group-hover:opacity-60" />
                                </div>
                                <div class="p-4 flex flex-col gap-y-2">
                                    <div>
                                        <h3 class="text-white text-xl font-semibold">
