            </div>
            <p class="text-white mt-8">Projects :</p>
            <div class="grid gap-4 mt-4 md:grid-cols-2">
                {
                    projects
                        .filter((project) => project.display)
                        .map((project) => (
                            <a
                                href={project.url}
                                target="_blank"
                                class="group rounded-2xl border border-white/10 bg-gray-900 backdrop-blur-sm overflow-hidden shadow-lg shadow-black/30 transition-all duration-300 hover:-translate-y-1 hover:border-white/30"
