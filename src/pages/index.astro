import heroVideo from "../assets/videos/me-raw.mp4";
import heroPoster from "../assets/me-hero-poster.webp";
import { Image } from "astro:assets";

const projects = [
    {
        name: "jobx.dev",
        summary:
            "Job aggregator that curates fresh tech opportunities posted on Twitter/X.",
        badge: "Job aggregator",
        url: "https://jobx.dev",
