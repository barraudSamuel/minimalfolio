        display: true,
    },
    {
        name: "ccup.io",
        summary:
            "Landing page + conversion experiments for a high-volume SaaS launch.",
        badge: "SaaS platform",
        url: "https://ccup.io",
        screenshot: screenCcup,
        display: true,
    },
    {
        name: "Scan Translator",
        summary: "Browser extension for manga OCR and translation workflows.",
