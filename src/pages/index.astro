---

<Layout>
    <div class="bg-light min-h-screen flex flex-col justify-start items-center">
        <section class="max-w-4xl w-full mt-12">
            <div class="flex flex-col justify-center items-center gap-10">
                <!--<AsciiVideo
                    src={heroVideo}
                    poster={heroPoster.src}
                    width={240}
                    height={240}
                    class="size-60 shrink-0"
                    scale={1}
                    spacing={0}
                    outputWidth={40}
                    outputHeight={40}
                    fps={18}
                    brightness={1}
                    contrast={1}
                    saturation={1}
                    hueRotation={0}
                    gamma={1}
                    intensity={1}
                    color="#002fa7"
                    secondaryColor="#8fa0d1"
                    backgroundColor="#f6f7f2"
                    characterSet="blocks"
                    sharpness={0.4}
                />-->
                <DitheredVideo
                    src={heroVideo}
                    poster={heroPoster.src}
                    width={240}
                    height={240}
                    class="size-60 shrink-0"
                    pixelation={10}
                    hoverPixelation={3}
                    pixelationTransitionDuration={500}
                    bootEffect
                    bootDuration={900}
                    bootLines={22}
                    brightness={1.3}
                    contrast={1.3}
                    detail={40}
                    color1="#002fa7"
                    color2="#f6f7f2"
                    color3="#f6f7f2"
                    bloom
                    bloomIntensity={0.55}
                    bloomRadius={24}
                    fallback="none"
                />
                <div class="px-5">
                    <h1
                        class="text-klein text-7xl font-semibold text-center font-doto"
                    >
                        samuel barraud
                    </h1>
                    <p
                        class="text-center text-klein font-geist-pixel text-md mt-4 max-w-2xl"
                    >
                        hi, I’m Sam, a 🇫🇷 full-stack web developer with 7 years
                        of experience, building stuff in Seoul 🇰🇷.
                    </p>
                    <div
                        class="mt-8 flex items-center justify-center gap-2 text-klein"
                    >
                        <a
                            href="https://www.youtube.com/@sam_brd"
                            target="_blank"
                            rel="noreferrer"
                            aria-label="YouTube"
                            class="flex size-16 items-center justify-center transition duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-klein"
                        >
                            <YoutubeIcon class="size-6" />
                        </a>
                        <a
                            href="https://github.com/barraudSamuel"
                            target="_blank"
                            rel="noreferrer"
                            aria-label="GitHub"
                            class="flex size-16 items-center justify-center transition duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-klein"
                        >
                            <GithubIcon class="size-6" />
                        </a>
                        <a
                            href="https://x.com/sam__brd"
                            target="_blank"
                            rel="noreferrer"
                            aria-label="X"
                            class="flex size-16 items-center justify-center transition duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-klein"
                        >
                            <XIcon class="size-6" />
                        </a>
                        <a
                            href="mailto:contact@sambrd.xyz"
                            aria-label="Email"
                            class="flex size-16 items-center justify-center transition duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-klein"
                        >
                            <EmailIcon class="size-6" />
                        </a>
                    </div>
                </div>
            </div>
        </section>
        <GithubContributions />
        <section class="w-full max-w-2xl mt-32 pb-20 px-5">
            <div class="flex flex-col items-center gap-3 text-center">
                <h2
                    class="font-doto text-4xl font-semibold text-klein tracking-tighter"
                >
                    check out my latest work
                </h2>
            </div>

            <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-2">
                {
                    projects
                        .filter((project) => project.display)
                        .map((project) => (
                            <a
                                href={project.url}
                                target="_blank"
                                rel="noreferrer"
                                class="group block bg-klein focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-klein"
                            >
                                <div class="aspect-4/3 overflow-hidden">
                                    <Image
                                        src={project.screenshot}
                                        alt={`${project.name} screenshot`}
                                        width={800}
                                        widths={[320, 480, 640, 800]}
                                        sizes="(min-width: 768px) 296px, calc(100vw - 40px)"
                                        layout="constrained"
                                        quality={70}
                                        class="h-full w-full object-cover"
                                    />
                                </div>

                                <div class="p-3 flex items-start justify-between gap-4">
                                    <div>
                                        <h3 class="mt-1 font-geist-pixel text-sm text-light">
                                            {project.name}
                                        </h3>
                                    </div>
                                    <svg
                                        class="mt-1 size-6 shrink-0 text-light transition-transform duration-200 group-hover:rotate-45 group-focus-visible:rotate-45"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                    >
                                        <path d="M7 17 17 7" />
                                        <path d="M8 7h9v9" />
                                    </svg>
                                </div>
                            </a>
                        ))
                }
            </div>
        </section>
    </div>
    <!--<Welcome />-->
    <!-- Legacy homepage section kept for reference.
